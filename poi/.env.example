# ==============================================
# POI 系统环境变量模板
# 使用方法:
#   cp .env.example .env
#   然后用真实凭据填充每一项
# .env 文件不要提交到 git
# ==============================================

# --- 服务配置 (同学 C) ---
PORT=3000
HOST=127.0.0.1
NODE_ENV=development
# Production deployment must replace this with the externally visible HTTPS origin.
# Use only scheme + host + optional port; credentials, path, query, and fragment are rejected.
PUBLIC_HOST=http://127.0.0.1:3000
MONGO_URI=mongodb://127.0.0.1:27017/poi_db
# Empty uses the safe default: true in production, false elsewhere.
# Set only the literal value true or false for an intentional override.
MONGO_STARTUP_FAIL_FAST=
CORS_ORIGIN=http://127.0.0.1:3000
GEOSYNC_BACKGROUND_ENABLED=true
SHUTDOWN_TIMEOUT_MS=10000
PORTAL_VERSION=
# Keep loopback for a same-host reverse proxy. Use a bounded hop count (0-10) or
# an exact trusted proxy IP/CIDR/list only when the topology requires it.
# Unsafe true/* and out-of-range hop counts fall back to loopback.
TRUST_PROXY=loopback

# --- 微信测试号 (同学 B) ---
# 申请: https://mp.weixin.qq.com/debug/cgi-bin/sandbox?t=sandbox/login
WX_APPID=
WX_SECRET=

# --- 微信模板 ID (同学 B 在测试号后台申请) ---
TPL_AUDIT_RESULT=
TPL_NEW_POI_WAIT=
TPL_ADMIN_NOTICE=
TPL_REROUTE=

# --- 阿里云 OCR (同学 A) ---
# 申请: https://ram.console.aliyun.com (RAM 子账号 + AliyunOCRFullAccess)
ALIYUN_AK=
ALIYUN_SK=
ALIYUN_ENDPOINT=ocr.cn-shanghai.aliyuncs.com
ALIYUN_OCR_API_ENDPOINT=ocr-api.cn-hangzhou.aliyuncs.com
OCR_READ_TIMEOUT=15000
OCR_CONNECT_TIMEOUT=5000

# --- 高德地图（浏览器只读取公开 Web JS key） ---
AMAP_KEY=
# jscode 由部署系统写入 /etc/nginx/snippets/poi-amap-jscode.conf，不进入 .env 或 client-config。

# --- 管理员身份（仅服务端；浏览器登录使用 HttpOnly 会话 Cookie） ---
# ADMIN_TOKEN 如启用，必须是独立、随机且不少于 32 字节的服务端 Bearer 凭据，禁止返回前端。
ADMIN_TOKEN=
ADMIN_USERNAME=
# 仅接受 npm run hash:admin-password 生成的版本化 scrypt 哈希；禁止配置旧 ADMIN_PASSWORD 明文变量。
ADMIN_PASSWORD_HASH=
# 权威审核员白名单，使用经负责人确认的 OpenID，逗号分隔；历史数据库角色不能替代该配置。
REVIEWER_OPENIDS=

# --- 身份与会话 ---
# 生产环境必须设置独立、随机且不少于 32 字节的 AUTH_SESSION_SECRET；模板保持空值。
# AUTH_SIGN_REQUIRED=false 仅允许非生产环境兼容旧 X-Open-Id 请求头。
AUTH_SESSION_SECRET=
AUTH_SIGN_REQUIRED=true
AUTH_USER_SESSION_TTL_SEC=604800
AUTH_ADMIN_SESSION_TTL_SEC=28800
# Browser and QR OAuth flows share this pending-flow cap per trusted request network.
AUTH_FLOW_MAX_PENDING_PER_NETWORK=8
SCREEN_SESSION_TTL_S=900
# 留空时根据 PUBLIC_HOST 自动推导：http 开发环境为 false，https 为 true。
# 生产模式拒绝 HTTP PUBLIC_HOST，也拒绝显式 AUTH_COOKIE_SECURE=false。
AUTH_COOKIE_SECURE=

# --- GeoSync 核心配置 ---
SCENIC_ID=default
SCENIC_TIME_ZONE=Asia/Shanghai
SCENIC_CENTER=
SCENIC_FENCE_RADIUS_M=3000
POSITION_HMAC_SECRET=
SCREEN_TOKEN=

# --- GeoSync runtime tuning ---
POSITION_MIN_INTERVAL_S=30
PRESENCE_LEASE_MINUTES=10
CI_SLOT_MINUTES=10
CI_ALPHA=0.5
CI_BETA=0.3
CI_GAMMA=0.2
REROUTE_GAIN_MIN=5
REROUTE_DAILY_SOFT_LIMIT=3
BARRIER_REROUTE_CONCURRENCY=6
CAPACITY_TOKEN_TTL_S=300
GEOSYNC_UPLOAD_DIR=

# --- Optional provider integrations (blank disables the feature) ---
RAIN_API_URL=
RAIN_API_KEY=
WEATHER_API_URL=
WEATHER_API_KEY=
LLM_API_URL=
LLM_API_KEY=
# 必须填写所接入兼容网关实际支持的模型 ID；留空时 AI 功能关闭。
LLM_MODEL=
HOLIDAY_API_URL=
DEM_TILE_DIR=./dem

# Simulation is development-only and rejected in production.
SIM_MODE=false
SIM_STRATEGY=anti-herding

# --- SuperMap / iServer 服务端配置 ---
SUPERMAP_ENABLED=true
SUPERMAP_MANIFEST_PATH=./config/supermap-manifest.json
ISERVER_BASE=http://127.0.0.1:8090
ISERVER_USERNAME=
ISERVER_PASSWORD=
SUPERMAP_TIMEOUT_MS=5000
SUPERMAP_HEALTH_TIMEOUT_MS=2000
SUPERMAP_MANIFEST_RETRY_MS=30000
SUPERMAP_MAX_RESPONSE_BYTES=10485760
SUPERMAP_CACHE_TTL_S=60
SUPERMAP_FALLBACK_ENABLED=true
SUPERMAP_MAX_RETRIES=1

# --- 邮件发送 SMTP（管理员发送点位到测试邮箱） ---
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
DEFAULT_TEST_EMAIL=
ALERT_EMAIL=
