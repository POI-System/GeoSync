# ==============================================
# POI 系统环境变量模板
# 使用方法:
#   cp .env.example .env
#   然后用真实凭据填充每一项
# .env 文件不要提交到 git
# ==============================================

# --- 服务配置 (同学 C) ---
PORT=3000
HOST=127.0.0.1
PUBLIC_HOST=http://127.0.0.1:3000
MONGO_URI=mongodb://127.0.0.1:27017/poi_db
CORS_ORIGIN=http://127.0.0.1:3000

# --- 微信测试号 (同学 B) ---
# 申请: https://mp.weixin.qq.com/debug/cgi-bin/sandbox?t=sandbox/login
WX_APPID=
WX_SECRET=

# --- 微信模板 ID (同学 B 在测试号后台申请) ---
TPL_AUDIT_RESULT=
TPL_NEW_POI_WAIT=
TPL_ADMIN_NOTICE=

# --- 阿里云 OCR (同学 A) ---
# 申请: https://ram.console.aliyun.com (RAM 子账号 + AliyunOCRFullAccess)
ALIYUN_AK=
ALIYUN_SK=
ALIYUN_ENDPOINT=ocr.cn-shanghai.aliyuncs.com
ALIYUN_OCR_API_ENDPOINT=ocr-api.cn-hangzhou.aliyuncs.com

# --- 高德地图 (同学 B 前端读取 /api/client-config) ---
AMAP_KEY=
AMAP_SEC=

# --- 管理员令牌 (同学 C 用于 socket 公告校验,前端 admin.html 登录后拿到) ---
ADMIN_TOKEN=
ADMIN_USERNAME=
ADMIN_PASSWORD=

# --- GeoSync 核心配置 ---
SCENIC_ID=default
SCENIC_CENTER=
SCENIC_FENCE_RADIUS_M=3000
POSITION_HMAC_SECRET=
SCREEN_TOKEN=

# --- SuperMap / iServer 服务端配置 ---
SUPERMAP_ENABLED=true
SUPERMAP_MANIFEST_PATH=./config/supermap-manifest.json
ISERVER_BASE=http://127.0.0.1:8090
ISERVER_USERNAME=
ISERVER_PASSWORD=
SUPERMAP_TIMEOUT_MS=5000
SUPERMAP_HEALTH_TIMEOUT_MS=2000
SUPERMAP_CACHE_TTL_S=60
SUPERMAP_FALLBACK_ENABLED=true
SUPERMAP_MAX_RETRIES=1

# --- 邮件发送 SMTP（管理员发送点位到测试邮箱） ---
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
DEFAULT_TEST_EMAIL=
